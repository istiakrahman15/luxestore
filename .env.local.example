# Copy this file to .env.local for local testing against production-style
# settings, or set these as Environment Variables in the Vercel dashboard
# (Project -> Settings -> Environment Variables).
#
# Never commit a real .env.local — it's already in .gitignore.

# Generate a real one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-secret-key

DEBUG=False

# Comma-separated. Vercel's own *.vercel.app domain is always allowed
# automatically — add your custom domain here once you have one.
ALLOWED_HOSTS=your-project.vercel.app

# Provided automatically when you attach a Postgres database in the Vercel
# dashboard (Storage -> Create Database). Format:
# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
